---
 kernel/setup.sh | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/kernel/setup.sh b/kernel/setup.sh
index 292e2c02..d9f12087 100755
--- a/kernel/setup.sh
+++ b/kernel/setup.sh
@@ -16,6 +16,8 @@ display_usage() {
