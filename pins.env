# Every source the build uses, at a fixed commit.
GOOG=https://android.googlesource.com

KERNEL_TAG=android13-5.15-2026-03_r2
KERNEL_SHA=2d8ad9139b89c200eba47ce69c7f2130b60f6e6f

# path|repo|sha  (build tree, from the common-android13-5.15-2026-03 manifest)
TREE="
common|$GOOG/kernel/common|$KERNEL_SHA
build/kernel|$GOOG/kernel/build|4f6ed7381c1553cca7c178a304be23eb284963c2
kernel/configs|$GOOG/kernel/configs|b3cc2bc03dab303c54a9ce1f709f8ee315eb311d
prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8|$GOOG/platform/prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8|007101a451907c5369db5002ddf7b14dcefb7864
prebuilts/build-tools|$GOOG/platform/prebuilts/build-tools|f6813860e16b2fa1461a15e7b8a3127dfdee021a
prebuilts/kernel-build-tools|$GOOG/kernel/prebuilts/build-tools|083e34d8c2c4239be4967172427268c267585951
tools/mkbootimg|$GOOG/platform/system/tools/mkbootimg|2208a03d874255af1e4eaf6cf7c156fe1dc98943
"
CLANG_VERSION=r450784e
CLANG_URL=$GOOG/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/master-kernel-build-2022/clang-$CLANG_VERSION.tar.gz

# path|repo|sha  (patch sources, outside the kernel tree)
EXTRA="
src/KernelSU-Next|https://github.com/KernelSU-Next/KernelSU-Next|1a879d6a866f80b1fa1c1009a2ffa747873cbb5e
src/susfs4ksu|https://gitlab.com/simonpunk/susfs4ksu.git|687d2d18d94cb2e3e72d1074778d58384d58e379
src/nomount|https://github.com/maxsteeel/nomount|e2e71eee266221b2100cc4845ebb5ca6b6f642e4
src/droidspaces|https://github.com/ravindu644/Droidspaces-OSS|92cee270dc40fd45edf7d17bb0517668920a89cc
src/kernel_patches|https://github.com/WildKernels/kernel_patches|41ae18b35d20e0c6ac04116785a4a1089528ae94
src/AnyKernel3|https://github.com/WildKernels/AnyKernel3|e1e9dce98430c5c6f231f7094a8c7f4ecaf50948
"

# KSU Next v3.4.0 (matches ksud 3.4.0, kernel version 33294) + pershoot's dev-susfs commits on top
KSUN_TAG=v3.4.0
PERSHOOT_REPO=https://github.com/pershoot/KernelSU-Next
PERSHOOT_SHA=9a8d3f03db9bd6d51410a6fd732d1db273692ca6
PERSHOOT_COUNT=8

# Factory kernel identity (docs/KERNEL.md), reproduced so uname and /proc/version look stock
LOCALVERSION_STR=-android13-8-g831ed15794af-dirty-ab157
BUILD_TIMESTAMP="Thu Jan 29 10:18:56 UTC 2026"
BUILD_USER=build-user
BUILD_HOST=build-host

# Only the NDK sysroot is needed (userprog link test, keeps CONFIG_CC_CAN_LINK=y as in stock)
NDK_SYSROOT_URL=$GOOG/toolchain/prebuilts/ndk/r23/+archive/93532f3052c14fbb337ff57d5732128dc7481ee6/toolchains/llvm/prebuilt/linux-x86_64/sysroot.tar.gz
